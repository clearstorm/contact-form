        "size": 66,
        "min": 0,
        "max": 100,
        "step": 5,
        "value": 60
      },
      {
        "type": "date",
        "id": "kickoff",
        "name": "kickoff",
        "label": "Kick-off date",
        "required": true,
        "size": 33
      },
      {
        "type": "time",
        "id": "preferred_time",
        "name": "preferred_time",
        "label": "Preferred time",
        "optional": true,
        "size": 33
      },
      {
        "type": "datetime-local",
        "id": "visit",
        "name": "visit",
        "label": "Site visit",
        "optional": true,
        "size": 33
      },
      {
        "type": "month",
        "id": "quarter",
        "name": "quarter",
        "label": "Target month",
        "optional": true,
        "size": 33
      },
      {
        "type": "week",
        "id": "week",
        "name": "week",
        "label": "Draft week",
        "optional": true,
        "size": 33
      },
      {
        "type": "color",
        "id": "brand",
        "name": "brand",
        "label": "Brand colour",
        "optional": true,
        "size": 33,
        "value": "#c46f48"
      },
      {
        "type": "select",
        "id": "budget",
        "name": "budget",
        "label": "Budget",
        "required": true,
        "size": 100,
        "options": [
          "Under R20k",
          "R20k–R60k",
          "Over R60k"
        ],
        "message": "Choose a budget."
      },
      {
        "type": "radio",
        "id": "contact_method",
        "name": "contact_method",
        "label": "Preferred contact method",
        "required": true,
        "size": 50,
        "options": [
          "Email",
          "Phone",
          "WhatsApp"
        ]
      },
      {
        "type": "checkbox",
        "id": "extras",
        "name": "extras",
        "label": "Project extras",
        "optional": true,
        "size": 50,
        "options": [
          "Copywriting",
          "Photography",
          "Hosting"
        ]
      },
      {
        "type": "checkbox",
        "id": "rush",
        "name": "rush",
        "label": "This is urgent",
        "size": 50
      },
      {
        "type": "file",
        "id": "portfolio",
        "name": "portfolio",
        "label": "Portfolio / samples",
        "required": false,
        "optional": true,
        "size": 50,
        "accept": ".pdf,image/*"
      },
      {
        "type": "step",
        "label": "Details"
      },
      {
        "type": "date",
        "id": "deadline",
        "name": "deadline",
        "label": "Ideal kick-off (needed when urgent)",
        "required": true,
        "size": 50,
        "showWhen": {
          "field": "rush",
          "operator": "filled"
        }
      },
      {
        "type": "textarea",
        "id": "brief",
        "name": "brief",
        "label": "Project brief",
        "required": true,
        "size": 100,
        "rows": 6,
        "maxlength": 500
      },
      {
        "type": "checkbox",
        "id": "consent",
        "name": "consent",
        "label": "I agree to the demo terms",
        "required": true,
        "size": 100,
        "message": "Please accept the terms to continue."
      },
      {
        "type": "hidden",
        "id": "source",
        "name": "source",
        "label": "Source",
        "value": "wizard-options-demo"
      }
    ]
  },
  "Compact chrome": {
    "name": "wizard-compact",
    "submit": {
      "label": "Submit",
      "variant": "primary"
    },
    "next": {
      "label": "Continue",
      "variant": "primary"
    },
    "prev": {
      "label": "Back",
      "variant": "ghost"
    },
    "stepper": {
      "nav": {
        "number": false,
        "clickable": false
      },
      "header": {
        "show": true,
        "align": "left"
      }
    },
    "status": "Thanks — the compact wizard worked end to end.",
    "mailer": "json",
    "endpoint": "http://localhost:8787/submit",
    "copy": {
      "sending": "Sending…",
      "submitError": "Sending failed (HTTP {status}) — is the echo server running (npm run demo:api)?"
    },
    "fields": [
      {
        "type": "heading",
        "text": "Compact wizard"
      },
      {
        "type": "description",
        "text": "The chrome options: no number chips, no jump-back links (plain informational stepper), a custom “Continue” label and a ghost “Back”. Step 2 swaps its pane header to `align: \"full\"` (title on its own line with a full rule beneath) and step 3 renders a bare pane (`show: false`)."
      },
      {
        "type": "step",
        "label": "Contact"
      },
      {
        "type": "text",
        "id": "name",
        "name": "name",
        "label": "Your name",
        "required": true,
        "size": 50
      },
      {
        "type": "email",
        "id": "email",
        "name": "email",
        "label": "Email address",
        "required": true,
        "size": 50
      },
      {
        "type": "tel",
        "id": "phone",
        "name": "phone",
        "label": "Phone (optional)",
        "optional": true,
        "size": 50
      },
      {
        "type": "step",
        "label": "Details",
        "title": "Anything else we should know?",
        "align": "full"
      },
      {
        "type": "textarea",
        "id": "notes",
        "name": "notes",
        "label": "Notes for the team",
        "optional": true,
        "size": 100,
        "rows": 5
      },
      {
        "type": "step",
        "label": "Done",
        "show": false
      },
      {
        "type": "checkbox",
        "id": "consent",
        "name": "consent",
        "label": "I confirm the details above",
        "required": true,
        "size": 100,
        "message": "Please confirm to continue."
      },
      {
        "type": "hidden",
        "id": "source",
        "name": "source",
        "label": "Source",
        "value": "wizard-compact-demo"
      }
    ]
