---
import DemoLayout from "../layouts/DemoLayout.astro";
import FormDemo from "../components/FormDemo.astro";
import generalSpec from "../../../specs/general.json";
import { getForm } from "../lib/forms";

const booking = getForm(generalSpec, "Booking (prefill)");
const allFields = getForm(generalSpec, "All 19 field types");
const structure = getForm(generalSpec, "Structure + decor");

const fieldTypes = [
  "text", "email", "tel", "url", "password", "search", "number",
  "date", "time", "datetime-local", "month", "week", "textarea",
  "select", "checkbox", "radio", "hidden", "range", "color",
];

const structureRows: Array<[string, string, string]> = [
  ["heading", '{ "type": "heading", "text": "…", "line": false }', "a full-width <code>&lt;h3&gt;</code> title; its rule is on by default (left → line on the right, right → line on the left, center → both sides), <code>line: false</code> renders text only"],
  ["description", '{ "type": "description", "text": "…", "size": 75 }', "muted helper text; <code>size</code> maps onto the 12-column grid (100/75/67/50/40/33/…)"],
  ["divider", '{ "type": "divider", "visible": false, "min": "2rem" }', "a thin rule, or with <code>visible: false</code> an invisible spacer"],
  ["section", '{ "type": "section", "label": "Contact details" }', "a section break; the optional <code>label</code> sits centered on the rule"],
];
---
<DemoLayout title="General forms demo">
  <p class="demo-kicker">prefill · every field type · form structure</p>
  <h1>General forms</h1>
  <p class="lead">
    The everyday forms that don't belong to a dedicated feature page — three
    named forms in one spec file (<code>examples/specs/general.json</code>): the
    full 19-type kitchen sink, a booking form run with
    <code>prefill="datetime"</code>, and a form decorated with structural
    elements.
  </p>

  <h2>All 19 field types</h2>
  <p class="lead">
    Every type the core renders and validates in a single spec — including a
    checkbox <em>group</em> (multi-value, joined into one payload field), a
    radio group, a single consent checkbox, hidden passthrough and per-field
    <code>message</code> overrides. Every optional-capable type is shown as
    <code>optional: true</code> here (renders a muted “(optional)” suffix and
    never blocks submit) alongside the required twins. The fields below span
    50 / 66 / 33 / 100 to show the 12-column row. Submit posts to the local
    echo server — start it with <code>npm run demo:api</code>.
  </p>

  <div class="demo-card">
    <FormDemo form={allFields} />
  </div>

  <h3>What each type does</h3>
  <table class="demo-table">
    <thead>
      <tr><th>Type</th><th>Renders as</th><th>Validation in this spec</th></tr>
    </thead>
    <tbody>
      <tr><td><code>text</code></td><td>text input</td><td>required (2+ chars applies only to <code>first_name</code>/<code>last_name</code>)</td></tr>
      <tr><td><code>email</code></td><td>email input</td><td>email format</td></tr>
      <tr><td><code>tel</code></td><td>tel input</td><td>optional here; 7–15 chars of digits/<code>+()- </code></td></tr>
      <tr><td><code>url</code></td><td>url input</td><td>optional here; scheme-ful URL</td></tr>
      <tr><td><code>password</code></td><td>password input</td><td>optional here (required only when required)</td></tr>
      <tr><td><code>search</code></td><td>search input</td><td>optional here (required only when required)</td></tr>
      <tr><td><code>number</code></td><td>number input</td><td>numeric, min 1 / max 10</td></tr>
      <tr><td><code>date</code> / <code>time</code> / <code>datetime-local</code> / <code>month</code> / <code>week</code></td><td>native inputs</td><td>optional here (required only when required)</td></tr>
      <tr><td><code>textarea</code></td><td>textarea (rows 6)</td><td>min length 10, maxlength 500</td></tr>
      <tr><td><code>select</code></td><td>select</td><td>required only</td></tr>
      <tr><td><code>checkbox</code></td><td>group or single toggle</td><td>group: at least one checked; single: must be checked</td></tr>
      <tr><td><code>radio</code></td><td>radio group</td><td>one option required</td></tr>
      <tr><td><code>hidden</code></td><td>hidden input</td><td>never validated, forwarded as-is</td></tr>
      <tr><td><code>range</code></td><td>range input</td><td>within min 0 / max 100 (step 5)</td></tr>
      <tr><td><code>color</code></td><td>color input</td><td>optional here; hex <code>#rrggbb</code></td></tr>
    </tbody>
  </table>

  <h2>Booking + <code>prefill="datetime"</code></h2>
  <p class="lead">
    Rendered with <code>prefill="datetime"</code>: the date/time inputs start
    at today / near-now (the script also raises the date picker's
    <code>min</code> to today) while <em>both stay optional in the spec</em>.
    Date, time and the required guests select are spec fields outside the CF7
    core set — on submit they fold into the payload as labelled lines.
  </p>

  <div class="demo-card">
    <FormDemo form={booking} prefill="datetime" />
  </div>

  <h3>What the spec controls</h3>
  <table class="demo-table">
    <thead>
      <tr><th>Field</th><th>Spec</th><th>Result</th></tr>
    </thead>
    <tbody>
      <tr><td><code>date</code></td><td><code>required: false</code>, size 33</td><td>pre-filled, optional</td></tr>
      <tr><td><code>time</code></td><td><code>required: false</code>, size 33</td><td>pre-filled, optional</td></tr>
      <tr><td><code>guests</code></td><td><code>required: true</code>, size 33</td><td>required select, 1–8</td></tr>
      <tr><td><code>message</code></td><td><code>required: false</code></td><td>optional — folded into the payload only when filled</td></tr>
    </tbody>
  </table>

  <h2>Form structure</h2>
  <p class="lead">
    Structural elements shape a form without being fields: headings, helper
    descriptions (width-controllable), thin dividers or invisible spacers, and
    labeled section breaks. They render static markup only — no
    <code>name</code>, no validation, no payload entry — and never reach
    <code>data-rules</code>.
  </p>

  <div class="demo-card">
    <FormDemo form={structure} />
  </div>

  <h3>The four elements</h3>
  <table class="demo-table">
    <thead>
      <tr><th>Type</th><th>JSON</th><th>Renders</th></tr>
    </thead>
    <tbody>
      {structureRows.map(([type, json, renders]) => (
        <tr>
          <td><code>{type}</code></td>
          <td><code>{json}</code></td>
          <td set:html={renders} />
        </tr>
      ))}
    </tbody>
  </table>

  <p class="lead">
    Note the invisible spacer at the end of the structure form, which controls
    the gap before the submit row.
  </p>
</DemoLayout>