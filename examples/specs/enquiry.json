{
  "name": "enquiry",
  "submit": "Send enquiry",
  "status": "Thanks — we'll be in touch.",
  "mailer": "json",
  "endpoint": "http://localhost:8787/submit",
  "copy": {
    "sending": "Sending…",
    "submitError": "Sending failed (HTTP {status}) — is the echo server running (npm run demo:api)?"
  },
  "fields": [
    { "type": "text", "id": "first_name", "name": "first_name", "label": "First name", "required": true, "size": 50, "autocomplete": "given-name" },
    { "type": "text", "id": "last_name", "name": "last_name", "label": "Last name", "required": true, "size": 50, "autocomplete": "family-name" },
    { "type": "email", "id": "email", "name": "email", "label": "Email address", "required": true, "size": 50, "autocomplete": "email" },
    { "type": "tel", "id": "phone", "name": "phone", "label": "Phone", "required": false, "optional": true, "size": 50 },
    {
      "type": "select",
      "id": "service",
      "name": "service",
      "label": "Service",
      "required": true,
      "size": 100,
      "options": ["Website", "Brand identity", "Other"],
      "message": "Choose a service."
    },
    {
      "type": "text",
      "id": "other_service",
      "name": "other_service",
      "label": "Describe the service",
      "required": true,
      "size": 100,
      "placeholder": "e.g. event consulting",
      "showWhen": { "field": "service", "operator": "equals", "value": "Other" }
    },
    { "type": "checkbox", "id": "rush", "name": "rush", "label": "This is urgent", "size": 100 },
    {
      "type": "date",
      "id": "deadline",
      "name": "deadline",
      "label": "Ideal deadline",
      "required": true,
      "size": 100,
      "showWhen": { "field": "rush", "operator": "filled" }
    },
    { "type": "textarea", "id": "message", "name": "message", "label": "Message", "required": true, "size": 100, "rows": 5 }
  ]
}