          "3",
          "4",
          "5",
          "6",
          "7",
          "8"
        ],
        "message": "Choose the number of guests."
      },
      {
        "type": "textarea",
        "id": "message",
        "name": "message",
        "label": "Special requests",
        "required": false,
        "optional": true,
        "size": 100,
        "rows": 4
      }
