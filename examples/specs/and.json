{
  "name": "and",
  "submit": "Send",
  "status": "Thanks — the AND condition held.",
  "mailer": "json",
  "endpoint": "http://localhost:8787/submit",
  "copy": {
    "sending": "Sending…",
    "submitError": "Sending failed (HTTP {status}) — is the echo server running (npm run demo:api)?"
  },
  "fields": [
    {
      "type": "text",
      "id": "name",
      "name": "name",
      "label": "Name",
      "required": true,
      "size": 50
    },
    {
      "type": "email",
      "id": "email",
      "name": "email",
      "label": "Email address",
      "required": true,
      "size": 50
    },
    {
      "type": "select",
      "id": "service",
      "name": "service",
      "label": "Service",
      "required": true,
      "size": 100,
      "options": ["Website", "Brand identity", "Other"],
      "message": "Choose a service."
    },
    {
      "type": "checkbox",
      "id": "rush",
      "name": "rush",
      "label": "This is urgent",
      "size": 100
    },
    {
      "type": "textarea",
      "id": "and_note",
      "name": "and_note",
      "label": "AND — only when Service is “Other” and “This is urgent” is ticked",
      "required": true,
      "size": 100,
      "showWhen": [
        { "field": "service", "operator": "equals", "value": "Other" },
        { "field": "rush", "operator": "filled" }
      ]
    }
  ]
}