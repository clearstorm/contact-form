        "autocomplete": "given-name"
      },
      {
        "type": "text",
        "id": "last_name",
        "name": "last_name",
        "label": "Last name",
        "required": true,
        "size": 50,
        "autocomplete": "family-name"
      },
      {
        "type": "email",
        "id": "email",
        "name": "email",
        "label": "Email address",
        "required": true,
        "size": 50,
        "autocomplete": "email"
      },
      {
        "type": "tel",
