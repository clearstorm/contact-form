---
/**
 * Reusable contact form (Astro component) — thin shell over the shared runtime.
 *
 * All markup, client behaviour and styling now live in the framework-agnostic
 * `src/runtime/` layer:
 * - markup   → `renderFormShell` (src/runtime/markup.ts)
 * - client   → `initForms`      (src/runtime/engine.ts)
 * - styles   → src/runtime/styles.css
 *
 * The component keeps its exact public surface (props, emitted DOM) and just
 * delegates. Markup, validation, wizard state and theming can no longer drift
 * from the React / vanilla JS bindings.
 */
import { renderFormShell } from "../runtime/markup";
import { initForms } from "../runtime/engine";
import type { FormSpec } from "../core";

interface Props {
  form: FormSpec;
  /** Explicit endpoint overrides — take precedence over the form spec. */
  config?: {
    endpoint?: string;
    apiUrl?: string;
    cf7FormId?: string;
  };
  /**
   * "datetime" pre-fills date/time inputs with the current local date and a
   * near-now time (common for booking forms). Off by default.
   */
  prefill?: "datetime";
}

const html = renderFormShell(Astro.props as Props);
---

<Fragment set:html={html} />

<script>
  /**
   * Wire every contact-form instance rendered by this component. The shared
   * engine reads the serialised spec off each form's data-* attributes, so it
   * works regardless of how many forms share the page bundle.
   */
  import { initForms } from "../runtime/engine";
  initForms();
</script>