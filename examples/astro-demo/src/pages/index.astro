---
import DemoLayout from "../layouts/DemoLayout.astro";

const pages = [
  { href: "/general", title: "General forms", blurb: "Three named forms in one file — a booking form with prefill=\"datetime\", the full 19-type kitchen sink, and a form decorated with structural elements." },
  { href: "/conditional", title: "Conditional fields", blurb: "Fields reveal from the visitor's own input — three named forms in one spec file: a realistic enquiry, all seven showWhen operators, and an AND reveal." },
  { href: "/wizard", title: "Multi-step wizard", blurb: "Three named forms from one spec file — a flagship wizard, every field type on an even-slice stepper, and the compact chrome options." },
  { href: "/mailers", title: "Mailers", blurb: "Both transports on one page — the default cf7 mailer (WordPress CF7 endpoint, env-configurable) and the json mailer posting the canonical payload to a local echo server." },
  { href: "/theming", title: "Theming", blurb: "Both themes — light and dark — as two named forms in one spec file, re-themed purely via CSS custom properties." },
];
---
<DemoLayout title="Home — @clearstorm/contact-form demo">
  <p class="demo-kicker">Reference deployment</p>
  <h1>@clearstorm/contact-form demo</h1>
  <p class="lead">
    A minimal Astro site exercising the package end to end: the JSON form spec,
    all field types and validation rules, both transport mailers, the
    <code>prefill="datetime"</code> opt-in, consumer-driven copy and
    CSS-only theming.
  </p>

  <nav class="demo-grid" aria-label="Demo pages">
    {pages.map((page) => (
      <a class="demo-tile" href={page.href}>
        <h3>{page.title}</h3>
        <p>{page.blurb}</p>
      </a>
    ))}
  </nav>

  <div class="demo-card">
    <h2>Quickstart</h2>
    <p class="lead" style="margin-block:0 1rem">
      The forms are live in this repo — no WordPress or backend required unless
      you open the cf7 demo on the Mailers page. Forms using the
      <code>json</code> mailer post to a local echo server.
    </p>
    <pre>{`# terminal 1 — payload inspector for the json-mailer forms
cd examples/astro-demo
npm install
npm run demo:api

# terminal 2 — the demo site
npm run dev           # http://localhost:4321`}</pre>
  </div>
</DemoLayout>