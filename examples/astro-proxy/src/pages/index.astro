---
// Landing page — static in the hybrid-style build; the actual proxy is /api/contact.
const envelope = "{ provider, formId, to, payload }";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ContactForm transport proxy — Astro</title>
  </head>
  <body>
    <h1>Astro transport proxy</h1>
    <p>
      POST the <code>{envelope}</code> envelope to <code>/api/contact</code>.
      Server secrets live in <code>.env</code> — see the README and
      <code>docs/transport-proxies.md</code>.
    </p>
  </body>
</html>