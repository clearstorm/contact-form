---
/**
 * Structural (non-field) elements — thin shell over the shared `renderDecor`
 * builder (src/runtime/markup.ts). Headings, helper descriptions, dividers (or
 * invisible spacers) and labelled section breaks render static markup only —
 * they carry no input, never reach data-rules, validation or the payload.
 */
import { renderDecor } from "../runtime/markup";
import type { DecorSpec } from "../core";

interface Props {
  decor: DecorSpec;
}

const { decor } = Astro.props;
---

<Fragment set:html={renderDecor(decor)} />