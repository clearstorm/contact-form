        "size": 33,
        "min": 1,
        "max": 12,
        "step": 1,
        "message": "Pick a whole number from 1 to 12."
      },
      {
        "type": "range",
        "id": "priority",
        "name": "priority",
        "label": "Priority (0–100)",
