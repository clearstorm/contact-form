---
/**
 * Render an ordered list of form elements — thin shell over the shared
 * `renderElements` builder (src/runtime/markup.ts). Fields render as FormField
 * markup, structural elements as Decor markup. The caller must not pass `step`
 * markers here (consumed by `toSteps`); every element is a field or a decor.
 */
import { renderElements } from "../runtime/markup";
import type { FormElement } from "../core";

interface Props {
  elements: FormElement[];
  /**
   * Scopes every rendered element `id` (plus derived ids) under this prefix so
   * several forms on one page can share field names without colliding. Only
   * the `id` attribute is prefixed — `name` attributes (and therefore
   * payloads) are untouched. Defaults to no prefix.
   */
  idPrefix?: string;
}

const { elements, idPrefix = "" } = Astro.props;
---

<Fragment set:html={renderElements(elements, idPrefix)} />