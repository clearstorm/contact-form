{
  "Realistic enquiry": {
    "name": "enquiry",
    "submit": "Send enquiry",
    "status": "Thanks — we'll be in touch.",
    "mailer": "json",
    "endpoint": "http://localhost:8787/submit",
    "copy": {
      "sending": "Sending…",
      "submitError": "Sending failed (HTTP {status}) — is the echo server running (npm run demo:api)?"
    },
    "fields": [
      {
        "type": "text",
        "id": "first_name",
        "name": "first_name",
        "label": "First name",
        "required": true,
        "size": 50,
        "autocomplete": "given-name"
      },
      {
        "type": "text",
        "id": "last_name",
        "name": "last_name",
        "label": "Last name",
        "required": true,
        "size": 50,
        "autocomplete": "family-name"
      },
      {
        "type": "email",
        "id": "email",
        "name": "email",
        "label": "Email address",
        "required": true,
        "size": 50,
        "autocomplete": "email"
      },
      {
        "type": "tel",
        "id": "phone",
        "name": "phone",
        "label": "Phone",
        "required": false,
        "optional": true,
        "size": 50
      },
      {
        "type": "select",
        "id": "service",
        "name": "service",
        "label": "Service",
        "required": true,
        "size": 100,
        "options": [
          "Website",
          "Brand identity",
          "Other"
        ],
        "message": "Choose a service."
      },
      {
        "type": "text",
        "id": "other_service",
        "name": "other_service",
        "label": "Describe the service",
        "required": true,
        "size": 100,
        "placeholder": "e.g. event consulting",
        "showWhen": {
          "field": "service",
          "operator": "equals",
          "value": "Other"
        }
      },
      {
        "type": "checkbox",
        "id": "rush",
        "name": "rush",
        "label": "This is urgent",
        "size": 100
      },
      {
        "type": "date",
        "id": "deadline",
        "name": "deadline",
        "label": "Ideal deadline",
        "required": true,
        "size": 100,
        "showWhen": {
          "field": "rush",
          "operator": "filled"
        }
      },
      {
        "type": "textarea",
        "id": "message",
        "name": "message",
        "label": "Message",
        "required": true,
        "size": 100,
        "rows": 5
      }
    ]
  },
  "All seven operators": {
    "name": "conditions",
    "submit": "Send",
    "status": "Thanks — every operator behaved as declared.",
    "mailer": "json",
    "endpoint": "http://localhost:8787/submit",
    "copy": {
      "sending": "Sending…",
      "submitError": "Sending failed (HTTP {status}) — is the echo server running (npm run demo:api)?"
    },
    "fields": [
      {
        "type": "select",
        "id": "svc",
        "name": "svc",
        "label": "Service",
        "required": true,
        "size": 50,
        "options": [
          "Website",
          "Brand identity",
          "Other"
        ],
        "message": "Choose a service."
      },
      {
        "type": "text",
        "id": "svc_other",
        "name": "svc_other",
        "label": "equals — shown only when Service is “Other”",
        "required": true,
        "size": 50,
        "showWhen": {
          "field": "svc",
          "operator": "equals",
          "value": "Other"
        }
      },
      {
        "type": "select",
        "id": "project",
        "name": "project",
        "label": "Project type",
        "required": true,
        "size": 50,
        "options": [
          "New site",
          "Redesign",
          "Ongoing care"
        ],
        "message": "Choose a project type."
      },
      {
        "type": "url",
        "id": "current_url",
        "name": "current_url",
        "label": "notEquals — shown unless Project type is “New site”",
        "required": true,
        "size": 50,
        "placeholder": "https://…",
        "showWhen": {
          "field": "project",
          "operator": "notEquals",
          "value": "New site"
        }
      },
      {
        "type": "select",
        "id": "priority",
        "name": "priority",
        "label": "Package",
        "required": true,
        "size": 50,
        "options": [
          "Starter",
          "Growth",
          "Premium",
          "Not sure"
        ],
        "message": "Choose a package."
      },
      {
        "type": "text",
        "id": "priority_hint",
        "name": "priority_hint",
        "label": "in — shown when Package is Starter or Not sure",
        "required": true,
        "size": 50,
        "showWhen": {
          "field": "priority",
          "operator": "in",
          "value": [
            "Starter",
            "Not sure"
          ]
        }
      },
      {
        "type": "select",
        "id": "budget",
        "name": "budget",
        "label": "Budget",
        "required": true,
        "size": 50,
        "options": [
          "Under R20k",
          "R20k–R60k",
          "Over R60k"
        ],
        "message": "Choose a budget."
      },
      {
        "type": "text",
        "id": "budget_note",
        "name": "budget_note",
        "label": "notIn — hidden while Budget is “Over R60k”",
        "required": true,
        "size": 50,
        "showWhen": {
          "field": "budget",
          "operator": "notIn",
          "value": [
            "Over R60k"
          ]
        }
      },
      {
        "type": "checkbox",
        "id": "topics",
        "name": "topics",
        "label": "Topics (checkbox group)",
        "required": true,
        "size": 100,
        "options": [
          "Design",
          "Development",
          "Marketing",
          "Other"
        ],
        "message": "Tick at least one topic."
      },
      {
        "type": "text",
        "id": "topics_other",
        "name": "topics_other",
        "label": "includes — shown while “Other” is ticked",
        "required": true,
        "size": 100,
        "showWhen": {
          "field": "topics",
          "operator": "includes",
          "value": "Other"
        }
      },
      {
        "type": "checkbox",
        "id": "rush",
        "name": "rush",
        "label": "filled — tick to reveal a deadline",
        "size": 50
      },
      {
        "type": "date",
        "id": "deadline",
        "name": "deadline",
        "label": "Ideal deadline",
        "required": true,
        "size": 50,
        "showWhen": {
          "field": "rush",
          "operator": "filled"
        }
      },
      {
        "type": "checkbox",
        "id": "call",
        "name": "call",
        "label": "empty — visible while “Call me” is unticked",
        "size": 50
      },
      {
        "type": "text",
        "id": "email_note",
        "name": "email_note",
        "label": "We'll email you instead",
        "required": false,
        "optional": true,
        "size": 50,
        "showWhen": {
          "field": "call",
          "operator": "empty"
        }
      }
    ]
  },
  "AND — every condition must hold": {
    "name": "and",
    "submit": "Send",
    "status": "Thanks — the AND condition held.",
    "mailer": "json",
    "endpoint": "http://localhost:8787/submit",
    "copy": {
      "sending": "Sending…",
      "submitError": "Sending failed (HTTP {status}) — is the echo server running (npm run demo:api)?"
    },
    "fields": [
      {
        "type": "text",
        "id": "name",
        "name": "name",
        "label": "Name",
        "required": true,
        "size": 50
      },
      {
        "type": "email",
        "id": "email",
        "name": "email",
        "label": "Email address",
        "required": true,
        "size": 50
      },
      {
        "type": "select",
        "id": "service",
        "name": "service",
        "label": "Service",
        "required": true,
        "size": 100,
        "options": [
          "Website",
          "Brand identity",
          "Other"
        ],
        "message": "Choose a service."
      },
      {
        "type": "checkbox",
        "id": "rush",
        "name": "rush",
        "label": "This is urgent",
        "size": 100
      },
      {
        "type": "textarea",
        "id": "and_note",
        "name": "and_note",
        "label": "AND — only when Service is “Other” and “This is urgent” is ticked",
        "required": true,
        "size": 100,
        "showWhen": [
          {
            "field": "service",
            "operator": "equals",
            "value": "Other"
          },
          {
            "field": "rush",
            "operator": "filled"
          }
        ]
      }
    ]
  },
  "Logical combinations": {
    "name": "logic",
    "submit": "Send",
    "status": "Thanks — every logical combination behaved as declared.",
    "mailer": "json",
    "endpoint": "http://localhost:8787/submit",
    "copy": {
      "sending": "Sending…",
      "submitError": "Sending failed (HTTP {status}) — is the echo server running (npm run demo:api)?"
    },
    "fields": [
      {
        "type": "select",
        "id": "plan",
        "name": "plan",
        "label": "Plan",
        "required": true,
        "size": 50,
        "options": [
          "Starter",
          "Enterprise",
          "Custom"
        ],
        "message": "Choose a plan."
      },
      {
        "type": "text",
        "id": "procurement_code",
        "name": "procurement_code",
        "label": "anyOf — shown when Plan is “Enterprise” or “Custom”",
        "size": 50,
        "placeholder": "e.g. ENT-42",
        "showWhen": {
          "anyOf": [
            {
              "field": "plan",
              "operator": "equals",
              "value": "Enterprise"
            },
            {
              "field": "plan",
              "operator": "equals",
              "value": "Custom"
            }
          ]
        }
      },
      {
        "type": "number",
        "id": "team_size",
        "name": "team_size",
        "label": "Team size",
        "optional": true,
        "size": 50,
        "placeholder": "0"
      },
      {
        "type": "text",
        "id": "custom_quote",
        "name": "custom_quote",
        "label": "greaterThan — shown when Team size > 50",
        "size": 50,
        "showWhen": {
          "field": "team_size",
          "operator": "greaterThan",
          "value": 50
        }
      },
      {
        "type": "email",
        "id": "visitor_email",
        "name": "visitor_email",
        "label": "Email address",
        "required": true,
        "size": 50
      },
      {
        "type": "text",
        "id": "student_discount",
        "name": "student_discount",
        "label": "endsWith — shown when the email ends in “.edu”",
        "size": 50,
        "showWhen": {
          "field": "visitor_email",
          "operator": "endsWith",
          "value": ".edu"
        }
      },
      {
        "type": "checkbox",
        "id": "services",
        "name": "services",
        "label": "Services (checkbox group)",
        "size": 100,
        "options": [
          "On-premise",
          "Hardware Support",
          "Training"
        ]
      },
      {
        "type": "text",
        "id": "hardware_specs",
        "name": "hardware_specs",
        "label": "containsAll — shown when On-premise AND Hardware Support are ticked",
        "size": 100,
        "showWhen": {
          "field": "services",
          "operator": "containsAll",
          "value": [
            "On-premise",
            "Hardware Support"
          ]
        }
      },
      {
        "type": "checkbox",
        "id": "dont_call",
        "name": "dont_call",
        "label": "Opt out of the callback",
        "size": 50
      },
      {
        "type": "text",
        "id": "callback_note",
        "name": "callback_note",
        "label": "not — visible while “Opt out” is unticked",
        "size": 50,
        "showWhen": {
          "not": {
            "field": "dont_call",
            "operator": "filled"
          }
        }
      }
    ]
  }
}
