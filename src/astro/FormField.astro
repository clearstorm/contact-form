---
interface Props {
  label: string;
  id: string;
  name: string;
  type?: string;
  required?: boolean;
  optional?: boolean;
  autocomplete?: string;
  rows?: number;
  /** Select options, or the choices of a checkbox/radio group. */
  options?: string[];
  /** Grid span in 12-column columns (from `gridSpan`; 50% → 6) — renders as
   the `rf-span-{n}` class. */
  span?: number;
  /** Input passthrough attributes. */
  placeholder?: string;
  value?: string;
  min?: number | string;
  max?: number | string;
  step?: number | string;
  maxlength?: number;
  pattern?: string;
  /** Accept hint for file inputs (picker filter only). */
  accept?: string;
  /** Multiple files / multi-select. */
  multiple?: boolean;
}

const {
  label,
  id,
  name,
  type = "text",
  required = false,
  optional = false,
  autocomplete,
  rows = 6,
  options,
  span = 50,
  placeholder,
  value,
  min,
  max,
  step,
  maxlength,
  pattern,
  accept,
  multiple,
} = Astro.props;

const isGroup = (type === "checkbox" || type === "radio") && (options?.length ?? 0) > 0;
const isSingleCheckbox = type === "checkbox" && !((options?.length ?? 0) > 0);
---

<div
  class={`rf-field rf-span-${span}${type === "hidden" ? " rf-field--hidden" : ""}`}
>
  {type !== "hidden" &&
    (isGroup ? (
      <span class="rf-label" id={`${id}-label`}>
        {label}
        {optional && <span class="rf-optional"> Optional</span>}
      </span>
    ) : !isSingleCheckbox ? (
      <label for={id} class="rf-label">
        {label}
        {optional && <span class="rf-optional"> Optional</span>}
      </label>
    ) : null)}

  {type === "hidden" ? (
    <input type="hidden" id={id} name={name} value={value ?? ""} />
  ) : isGroup ? (
    <div class="rf-options" role="group" aria-labelledby={`${id}-label`}>
      {options!.map((option, i) => (
        <label class="rf-option">
          <input
            type={type === "checkbox" ? "checkbox" : "radio"}
            name={name}
            value={option}
            required={required}
            id={`${id}-${i}`}
          />
          <span>{option}</span>
        </label>
      ))}
    </div>
  ) : isSingleCheckbox ? (
    <label class="rf-option rf-option--single">
      <input type="checkbox" id={id} name={name} required={required} />
      <span class="rf-label">
        {label}
        {optional && <span class="rf-optional"> Optional</span>}
      </span>
    </label>
  ) : type === "textarea" ? (
    <textarea
      id={id}
      name={name}
      rows={rows}
      required={required}
      placeholder={placeholder}
      maxlength={maxlength}
      class="rf-input rf-textarea"
    ></textarea>
  ) : type === "select" ? (
    <select
      id={id}
      name={name}
      required={required}
      class="rf-input"
      multiple={multiple}
      size={multiple ? rows : undefined}
    >
      {options.map((option) => <option>{option}</option>)}
    </select>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      autocomplete={autocomplete}
      required={required}
      placeholder={placeholder}
      value={type === "file" ? undefined : value}
      min={min}
      max={max}
      step={step}
      maxlength={maxlength}
      pattern={pattern}
      accept={accept}
      multiple={multiple}
      list={options?.length ? `${id}-list` : undefined}
      class="rf-input"
    />
  )}
  {type !== "hidden" && type !== "select" && type !== "textarea" && !isGroup && !isSingleCheckbox && options?.length ? (
    <datalist id={`${id}-list`}>
      {options.map((option) => <option value={option} />)}
    </datalist>
  ) : null}
</div>

<style is:global>
  /* ---- Contact form fields (namespaced; themeable via --rf-* custom props) ---- */

  .rf-field {
    display: flex;
    flex-direction: column;
    gap: var(--rf-field-gap, 0.375rem);
    min-width: 0;
  }

  .rf-field--hidden {
    display: none;
  }

  .rf-label {
    font-size: var(--rf-label-size, 0.82rem);
    font-weight: var(--rf-label-weight, 600);
    letter-spacing: 0.06em;
    color: var(--rf-label-color, inherit);
  }

  .rf-label .rf-optional {
    font-weight: 400;
    color: var(--rf-muted, #6b7280);
  }

  .rf-field input:not(input[type="checkbox"]):not(input[type="radio"]),
  .rf-field select,
  .rf-field textarea {
    width: 100%;
    min-height: var(--rf-field-min-height, 2.75rem);
    border: 1px solid var(--rf-field-border, #d1d5db);
    border-radius: 2px;
    background: var(--rf-field-bg, #ffffff);
    color: var(--rf-field-text, #111827);
    padding: var(--rf-field-padding-y, 0.5rem) var(--rf-field-padding-x, 0.75rem);
    color-scheme: var(--rf-color-scheme, light);
    font: inherit;
    outline: 2px solid transparent;
    outline-offset: 2px;
  }

  .rf-field input:not(input[type="checkbox"]):not(input[type="radio"]):focus-visible,
  .rf-field select:focus-visible,
  .rf-field textarea:focus-visible {
    outline-color: var(--rf-focus, #2563eb);
  }

  .rf-field input[type="range"] {
    min-height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .rf-field input[type="color"] {
    padding: 0.125rem;
  }

  .rf-field textarea {
    min-height: var(--rf-textarea-min-height, 7rem);
    resize: vertical;
  }

  /* Checkbox / radio groups and single options — natural sizing, no full-width styling. */
  .rf-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem var(--rf-gap-x, 0.75rem);
    padding-top: 0.25rem;
  }

  .rf-option {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--rf-label-color, inherit);
    cursor: pointer;
  }

  .rf-option input {
    width: auto;
    min-height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    accent-color: var(--rf-focus, #2563eb);
    outline: 2px solid transparent;
    outline-offset: 2px;
  }

  .rf-option input:focus-visible {
    outline-color: var(--rf-focus, #2563eb);
  }

  .rf-option--single .rf-label {
    font-size: 0.9rem;
    font-weight: 400;
  }

  /* Field error state (added by the form's script at runtime). */
  .rf-input-invalid {
    border-color: var(--rf-danger, #dc2626) !important;
    outline-color: var(--rf-danger, #dc2626) !important;
  }

  .rf-field-error {
    margin: -0.15rem 0 0;
    color: var(--rf-danger, #dc2626);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  /* 12-column row spans on desktop — the wrapper carries `rf-span-{1..12}`
     (the span comes from `gridSpan` in the renderer). Below 48rem the grid is
     a single column and every element stacks full-width. */
  @media (min-width: 48rem) {
    .rf-span-1 { grid-column: span 1; }
    .rf-span-2 { grid-column: span 2; }
    .rf-span-3 { grid-column: span 3; }
    .rf-span-4 { grid-column: span 4; }
    .rf-span-5 { grid-column: span 5; }
    .rf-span-6 { grid-column: span 6; }
    .rf-span-7 { grid-column: span 7; }
    .rf-span-8 { grid-column: span 8; }
    .rf-span-9 { grid-column: span 9; }
    .rf-span-10 { grid-column: span 10; }
    .rf-span-11 { grid-column: span 11; }
    .rf-span-12 { grid-column: span 12; }
  }
</style>