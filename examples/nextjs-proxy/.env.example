# Copy to .env and fill in at least one provider. Never commit .env.
# The route only reads the variables for the provider the envelope names.

# Route whitelist guardrail (optional) — comma-separated formIds the route accepts.
ALLOWED_FORM_IDS="z10,10,30-4d-al,demo-form,5"

# --- Target: Contact Form 7 (WordPress) ---
CF7_BACKEND_URL="https://internal-cms.yourdomain.com"

# --- Target: Fluent Forms (WordPress) ---
FLUENT_FORMS_BACKEND_URL="https://internal-cms.yourdomain.com"

# --- Target: Resend ---
RESEND_API_KEY="re_123456789"
RESEND_TO_EMAIL="sales@yourdomain.com"

# --- Target: Postmark ---
POSTMARK_SERVER_TOKEN="postmark-server-token"

# --- Target: Sendgrid ---
SENDGRID_API_KEY="sg-sendgrid-api-key"

# --- Target: Mailchimp (newsletter subscriptions) ---
MAILCHIMP_API_KEY="mailchimp-api-key"
MAILCHIMP_AUDIENCE_ID="a1b2c3d4e5"
MAILCHIMP_SERVER_PREFIX="us1"

# --- Anti-bot verification (FormSpec `captcha` block → siteverify) ---
# The client sends { captchaProvider, captchaToken }; the route verifies the
# token with the secret matching the provider before dispatching. Leave empty
# to disable — forms built without a `captcha` block never send tokens.
# Cloudflare Turnstile always-pass test keys (used by the demo form):
#   sitekey 1x00000000000000000000AA   secret 1x00000000000000000000AA
TURNSTILE_SECRET_KEY="1x00000000000000000000AA"
RECAPTCHA_SECRET_KEY=""
HCAPTCHA_SECRET_KEY=""