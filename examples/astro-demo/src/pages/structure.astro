---
import DemoLayout from "../layouts/DemoLayout.astro";
import FormDemo from "../components/FormDemo.astro";
import structure from "../../../specs/structure.json";
import { getForms } from "../lib/forms";

const [, structureForm] = getForms(structure)[0];

const structureRows: Array<[string, string, string]> = [
  ["heading", '{ "type": "heading", "text": "…", "line": false }', "a full-width <code>&lt;h3&gt;</code> title; its rule is on by default (left → line on the right, right → line on the left, center → both sides), <code>line: false</code> renders text only"],
  ["description", '{ "type": "description", "text": "…", "size": 75 }', "muted helper text; <code>size</code> maps onto the 12-column grid (100/75/67/50/40/33/…)"],
  ["divider", '{ "type": "divider", "visible": false, "min": "2rem" }', "a thin rule, or with <code>visible: false</code> an invisible spacer"],
  ["section", '{ "type": "section", "label": "Contact details" }', "a section break; the optional <code>label</code> sits centered on the rule"],
];
---
<DemoLayout title="Form structure demo">
  <p class="demo-kicker">heading · description · divider · section</p>
  <h1>Form structure</h1>
  <p class="lead">
    Structural elements shape a form without being fields: headings, helper
    descriptions (width-controllable), thin dividers or invisible spacers, and
    labeled section breaks. They render static markup only — no
    <code>name</code>, no validation, no payload entry — and never reach
    <code>data-rules</code>.
  </p>

  <div class="demo-card">
    <FormDemo form={structureForm} />
  </div>

  <h2>The four elements</h2>
  <table class="demo-table">
    <thead>
      <tr><th>Type</th><th>JSON</th><th>Renders</th></tr>
    </thead>
    <tbody>
      {structureRows.map(([type, json, renders]) => (
        <tr>
          <td><code>{type}</code></td>
          <td><code>{json}</code></td>
          <td set:html={renders} />
        </tr>
      ))}
    </tbody>
  </table>

  <p class="lead">
    See <code>examples/specs/structure.json</code> for the full spec — and note the
    invisible spacer at the end of the form, which controls the gap before the
    submit row.
  </p>
</DemoLayout>