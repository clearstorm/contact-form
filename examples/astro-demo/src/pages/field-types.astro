---
import DemoLayout from "../layouts/DemoLayout.astro";
import FormDemo from "../components/FormDemo.astro";
import fieldTypesSpec from "../../../specs/field-types.json";
import { getForm } from "../lib/forms";

const allFields = getForm(fieldTypesSpec, "All 20 field types");
const structure = getForm(fieldTypesSpec, "Structural field types");
const validationExtras = getForm(fieldTypesSpec, "Validation extras");
const repeaters = getForm(fieldTypesSpec, "Repeat rows");

const structureRows: Array<[string, string, string]> = [
  ["heading", '{ "type": "heading", "text": "…", "line": false }', "a full-width <code>&lt;h3&gt;</code> title; its rule is on by default (left → line on the right, right → line on the left, center → both sides), <code>line: false</code> renders text only"],
  ["description", '{ "type": "description", "text": "…", "size": 75 }', "muted helper text; <code>size</code> maps onto the 12-column grid (100/75/67/50/40/33/…)"],
  ["divider", '{ "type": "divider", "visible": false, "min": "2rem" }', "a thin rule, or with <code>visible: false</code> an invisible spacer"],
  ["section", '{ "type": "section", "label": "Contact details" }', "a section break; the optional <code>label</code> sits centered on the rule"],
];
---
<DemoLayout title="Field types demo">
  <p class="demo-kicker">every input type · structural types · validation extras · repeaters</p>
  <h1>Field types</h1>
  <p class="lead">
    Four named forms in one spec file (<code>examples/specs/field-types.json</code>):
    the full 20-type kitchen sink, the structural field types, a validation-extras
    form and a repeat-rows form — every element a form can render, from a text
    input to a section break, plus the custom validation rules that layer on top
    of any field and the dynamic row groups that repeat them.
  </p>

  <h2>All 20 field types</h2>
  <p class="lead">
    Every type the core renders and validates in a single spec — including a
    checkbox <em>group</em> (multi-value, joined into one payload field), a
    radio group, a single consent checkbox, hidden passthrough and per-field
    <code>message</code> overrides. Every optional-capable type is shown as
    <code>optional: true</code> here (renders a muted “(optional)” suffix and
    never blocks submit) alongside the required twins. Beyond the 20 types the
    same spec also exercises three field capabilities: a <code>select</code>
    with <code>multiple: true</code>, <code>options</code> on a text input
    rendering a <code>datalist</code> of suggestions, and two <code>file</code>
    inputs (single required + <code>multiple</code> with an
    <code>accept</code> hint — their filenames travel in the canonical
    payload). The fields below span 50 / 67 / 33 / 100 to show the 12-column
    row. Submit posts to the local echo server — start it with
    <code>npm run demo:api</code>.
  </p>

  <div class="demo-card">
    <FormDemo form={allFields} />
  </div>

  <h3>What each type does</h3>
  <table class="demo-table">
    <thead>
      <tr><th>Type</th><th>Renders as</th><th>Validation in this spec</th></tr>
    </thead>
    <tbody>
      <tr><td><code>text</code></td><td>text input</td><td>required (2+ chars applies only to <code>first_name</code>/<code>last_name</code>)</td></tr>
      <tr><td><code>email</code></td><td>email input</td><td>email format</td></tr>
      <tr><td><code>tel</code></td><td>tel input</td><td>optional here; 7–15 chars of digits/<code>+()- </code></td></tr>
      <tr><td><code>url</code></td><td>url input</td><td>optional here; scheme-ful URL</td></tr>
      <tr><td><code>password</code></td><td>password input</td><td>optional here (required only when required)</td></tr>
      <tr><td><code>search</code></td><td>search input</td><td>optional here (required only when required)</td></tr>
      <tr><td><code>number</code></td><td>number input</td><td>numeric, min 1 / max 10</td></tr>
      <tr><td><code>date</code> / <code>time</code> / <code>datetime-local</code> / <code>month</code> / <code>week</code></td><td>native inputs</td><td>optional here (required only when required)</td></tr>
      <tr><td><code>textarea</code></td><td>textarea (rows 6)</td><td>min length 10, maxlength 500</td></tr>
      <tr><td><code>select</code></td><td>select — or multi-select with <code>multiple: true</code> (visible rows via <code>rows</code>)</td><td>required only; multi-select needs at least one option chosen</td></tr>
      <tr><td><code>checkbox</code></td><td>group or single toggle</td><td>group: at least one checked; single: must be checked</td></tr>
      <tr><td><code>radio</code></td><td>radio group</td><td>one option required</td></tr>
      <tr><td><code>hidden</code></td><td>hidden input</td><td>never validated, forwarded as-is</td></tr>
      <tr><td><code>range</code></td><td>range input</td><td>within min 0 / max 100 (step 5)</td></tr>
      <tr><td><code>color</code></td><td>color input</td><td>optional here; hex <code>#rrggbb</code></td></tr>
      <tr><td><code>file</code></td><td>file input (single, or <code>multiple</code> with an <code>accept</code> hint)</td><td>required: at least one file attached; the canonical payload carries the filename(s)</td></tr>
      <tr><td><code>text</code> + <code>options</code></td><td>text input with a <code>datalist</code> of suggestions</td><td>suggestions only — free text still allowed</td></tr>
    </tbody>
  </table>

  <h2>Structural field types</h2>
  <p class="lead">
    The structural field types shape a form without taking input: headings,
    helper descriptions (width-controllable), thin dividers or invisible
    spacers, and labeled section breaks. They are field types that render
    static markup only — no <code>name</code>, no validation, no payload entry —
    and never reach <code>data-rules</code>.
  </p>

  <div class="demo-card">
    <FormDemo form={structure} />
  </div>

  <h3>The four structural types</h3>
  <table class="demo-table">
    <thead>
      <tr><th>Type</th><th>JSON</th><th>Renders</th></tr>
    </thead>
    <tbody>
      {structureRows.map(([type, json, renders]) => (
        <tr>
          <td><code>{type}</code></td>
          <td><code>{json}</code></td>
          <td set:html={renders} />
        </tr>
      ))}
    </tbody>
  </table>

  <p class="lead">
    Note the invisible spacer at the end of the structure form, which controls
    the gap before the submit row.
  </p>

  <h2>Validation extras</h2>
  <p class="lead">
    Four validation rules layer on top of any field's type rule — same
    <code>Rule</code> objects through every binding (Astro shell, React
    adapter, vanilla <code>renderForm</code>, TanStack bridge). The form below
    exercises all of them: a <code>pattern</code> (regex) on a required VAT
    field with a per-field message, <code>minLength</code> /
    <code>maxLength</code> soft bounds (the <code>maxLength</code> fields render
    a live “N / max” character counter under the control), a
    <code>sameAs</code> confirm-password pair (the error clears live when you
    fix the original), and <code>minSelect</code> / <code>maxSelect</code>
    bounds on a checkbox group and a multi-select. The form-level
    <code>copy</code> bag overrides the <code>sameAs</code> and
    <code>selection</code> messages.
  </p>

  <div class="demo-card">
    <FormDemo form={validationExtras} />
  </div>

  <table class="demo-table">
    <thead>
      <tr><th>Rule</th><th>JSON</th><th>What it does</th></tr>
    </thead>
    <tbody>
      <tr><td><code>pattern</code></td><td><code>{ "{ \"pattern\": \"^[A-Z]{2}\\\\d{9}$\", \"message\": \"…\" }" }</code></td><td>regex enforced by the shared script (the form renders <code>novalidate</code>); mismatch shows the field's message. A broken pattern fails open — it never blocks input</td></tr>
      <tr><td><code>minLength</code> / <code>maxLength</code></td><td><code>{ "{ \"minLength\": 4, \"maxLength\": 8 }" }</code></td><td>soft length bounds for text-like values; <code>maxLength</code> additionally draws a live <code>0 / 8</code> counter under the control. <code>minLength</code> overrides the textarea's 10-char default</td></tr>
      <tr><td><code>sameAs</code></td><td><code>{ "{ \"sameAs\": \"account_password\" }" }</code></td><td>the value must equal another field's — confirm-password style; the pair is re-checked live whenever the target changes</td></tr>
      <tr><td><code>minSelect</code> / <code>maxSelect</code></td><td><code>{ "{ \"minSelect\": 2, \"maxSelect\": 3 }" }</code></td><td>allowed checked/selected count on checkbox/radio groups and multi-selects; <code>minSelect &gt; 0</code> implies required</td></tr>
    </tbody>
  </table>

  <h2>Repeat rows</h2>
  <p class="lead">
    A <code>repeater</code> renders a row group: any field types nest inside its
    <code>fields</code>, and the visitor can add and remove rows. Below, a team
    members group is bounded with <code>minRows: 1</code> /
    <code>maxRows: 3</code> (the add button disables at the ceiling, remove at
    the floor), and an unbounded links group starts as a single row with no
    limit. Each row validates by itself (an empty required field flags only
    that row), and on submit every row group travels in the canonical payload
    as one structured JSON array under its own name — an empty row is dropped
    (or padded back to <code>minRows</code>). Row labels come from
    <code>addLabel</code> / <code>removeLabel</code>, falling back to the
    form-level <code>copy.addRow</code> / <code>copy.removeRow</code> keys.
  </p>

  <div class="demo-card">
    <FormDemo form={repeaters} />
  </div>
</DemoLayout>