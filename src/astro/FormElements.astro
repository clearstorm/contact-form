---
/**
 * Render an ordered list of form elements — fields render as `FormField`,
 * structural elements as `Decor`. Used by ContactForm for the single-page
 * layout, the wizard's shared prefix, and each step pane. The caller must not
 * pass `step` markers here (they are consumed by `toSteps`); every element is
 * either a field or a visual decor.
 */
import FormField from "./FormField.astro";
import Decor from "./Decor.astro";
import { isFieldSpec, gridSpan, type FormElement } from "../core";

interface Props {
  elements: FormElement[];
  /**
   * Scopes every rendered element `id` (plus derived ids) under this prefix so
   * several forms on one page can share field names without colliding. Only
   * the `id` attribute is prefixed — `name` attributes (and therefore
   * payloads) are untouched. Defaults to no prefix.
   */
  idPrefix?: string;
}

const { elements, idPrefix = "" } = Astro.props;

/** Element `id` → attribute value, scoped under `idPrefix` when set. */
const scopedId = (element: { id?: string; name: string }) => {
  const raw = element.id ?? element.name;
  return idPrefix ? `${idPrefix}__${raw}` : raw;
};
---
{elements.map((element) =>
  isFieldSpec(element) ? (
    <FormField
      label={element.label}
      id={scopedId(element)}
      name={element.name}
      type={element.type}
      autocomplete={element.autocomplete}
      required={element.required}
      optional={element.optional}
      rows={element.rows}
      options={element.options}
      span={gridSpan(element.size)}
      placeholder={element.placeholder}
      value={element.value}
      min={element.min}
      max={element.max}
      step={element.step}
      maxlength={element.maxlength}
      pattern={element.pattern}
    />
  ) : (
    <Decor decor={element} />
  ),
)}